# Compilados de .NET (los genera dotnet build; jamás se versionan)
bin/
obj/

# Archivos de sesión de SQLTools (borradores personales de SQL)
*.session.sql

# Archivos de usuario de IDEs
*.user
.vs/

# Bytecode de Python: lo genera el interprete en cada arranque y cambia solo.
# Versionarlo ensucia cada diff con archivos que nadie escribio.
__pycache__/
*.pyc
